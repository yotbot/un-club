---
const how = [
  { t: "Kies een doel.", d: "Je eerste 10K, drie keer per week bewegen, sterker worden, fit voor de skivakantie, of gewoon: meer energie." },
  { t: "Kies jouw manier.", d: "Buiten of binnen, alleen of samen, ochtend of avond, gratis of betaald, en de sporten die je leuk vindt." },
  { t: "Volg de route.", d: "Iedere week een programma uit echte activiteiten. Eén tik en je staat op de deelnemerslijst." },
  { t: "Trainers publiceren routes.", d: "Een coach zet een programma van twaalf weken op de kaart en sporters lopen het samen, als groep." },
];

const week = [
  { id: "r-social", day: "DI 18:30", title: "Social Run, 5K rustig", meta: "700 m · gratis · met je runclub" },
  { id: "r-interval", day: "DO 19:00", title: "Intervaltraining bij coach Sam", meta: "1,2 km · €8 · 4 plekken" },
  { id: "r-walk", day: "ZA 10:00", title: "Walking Group (herstel)", meta: "900 m · gratis" },
  { id: "r-long", day: "ZO 09:00", title: "Lange duurloop, 7K", meta: "Vondelpark · gratis · 14 deelnemers" },
];
---

<section class="section route" id="route" data-theme="light">
  <div class="container route-grid">
    <div>
      <p class="eyebrow" data-reveal>Route</p>
      <h2 class="display h2 route-title" data-split>Jouw doel. Jouw manier. Een route uit echte momenten.</h2>
      <p class="route-text" data-reveal>
        Ieder trainingsschema ter wereld bestaat uit oefeningen op papier. ROUTE bestaat uit dingen die vanavond echt
        gebeuren, bij jou in de buurt. Je kiest een doel en vertelt hoe jij het liefst beweegt. UNCLUB bouwt daar een
        weekprogramma van, samengesteld uit activiteiten op de kaart. Sla je een sessie over, dan herrekent de route
        zichzelf.
      </p>

      <p class="how-label" data-reveal>Zo werkt het</p>
      <ol class="how" data-stagger>
        {
          how.map((h, i) => (
            <li data-stagger-item>
              <span class="how-n">{i + 1}</span>
              <p>
                <b>{h.t}</b> {h.d}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="route-card" data-route>
      <div class="route-card-head">
        <p class="route-kicker">Route · Eerste 10K in 12 weken</p>
        <p class="route-prefs">Buiten · sociaal · avonden · liefst gratis <span>Week 3 van 12</span></p>
      </div>

      <ul class="route-week">
        {
          week.map((w) => (
            <li data-route-row>
              <span class="route-day">{w.day}</span>
              <span class="route-main">
                <b>{w.title}</b>
                <span class="route-meta">{w.meta}</span>
              </span>
              <button type="button" class="join" data-join={w.id} aria-pressed="false">
                JOIN →
              </button>
            </li>
          ))
        }
      </ul>

      <div class="route-progress">
        <p class="route-progress-text">
          <b>Voortgang: <span data-count-to="9">9</span> van 11 sessies gedaan</b> · langste loop 6,2 km
        </p>
        <div class="bar" aria-hidden="true"><span class="bar-fill" data-route-bar style="--p:0.818"></span></div>
        <p class="route-next">Volgende week: eerste keer 8K, samen met 6 anderen op dezelfde route.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .route-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .route-title {
    margin-top: 1.25rem;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 4.4rem);
  }

  .route-text {
    margin-top: 1.75rem;
    max-width: 54ch;
  }

  .how-label {
    margin-top: 2.5rem;
    color: var(--orange);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .how {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .how li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
  }

  .how-n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .route-card {
    position: sticky;
    top: 7rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-top: 6px solid var(--orange);
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--paper);
    box-shadow: 0 2rem 4rem -2.5rem rgb(0 0 0 / 0.3);
  }

  .route-kicker {
    color: var(--orange);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .route-prefs {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .route-prefs span::before {
    content: " · ";
  }

  .route-week {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .route-week li {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .route-day {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .route-main {
    display: grid;
    line-height: 1.3;
  }

  .route-main b {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    font-weight: 750;
  }

  .route-meta {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .route-progress {
    margin-top: 1.25rem;
  }

  .route-progress-text {
    font-size: 0.9rem;
  }

  .bar {
    height: 0.5rem;
    margin-top: 0.75rem;
    border-radius: 1rem;
    background: var(--cream);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    transform: scaleX(var(--p));
    transform-origin: left;
  }

  .route-next {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 60rem) {
    .route-grid {
      grid-template-columns: 1fr;
    }
    .route-card {
      position: static;
    }
  }

  @media (max-width: 30rem) {
    .route-week li {
      grid-template-columns: 1fr auto;
    }
    .route-day {
      grid-column: 1 / -1;
    }
  }
</style>
